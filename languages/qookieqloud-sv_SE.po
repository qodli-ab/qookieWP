#: inc/connection-view.php
msgid "API connection available"
msgstr "API-anslutningen är tillgänglig"

#: inc/connection-view.php
msgid "API data currently unavailable"
msgstr "API-data är inte tillgängliga just nu"

#: inc/connection-view.php
msgid "Accepted today"
msgstr "Accepterat idag"

#: inc/connection-view.php
msgid "Approve, return here and review your banner settings."
msgstr "Godkänn, återvänd hit och kontrollera bannerinställningarna."

#: inc/connection-view.php
msgid "Banner enabled"
msgstr "Bannern är aktiverad"

#: inc/connection-view.php
msgid "Banner paused"
msgstr "Bannern är pausad"

#: inc/connection-view.php
msgid "Banner settings"
msgstr "Bannerinställningar"

#: inc/v2.php
msgid "Change connection"
msgstr "Byt anslutning"

#: inc/v2.php
msgid "Change connection? The current connection remains until the new connection is approved and saved."
msgstr "Byta anslutning? Den nuvarande anslutningen behålls tills den nya har godkänts och sparats."

#: inc/connection-view.php
msgid "Choose a domain you manage, or add a new one."
msgstr "Välj en domän du hanterar eller lägg till en ny."

#: inc/connection-view.php
msgid "Clear the site cache after changing these settings."
msgstr "Töm webbplatsens cache efter att du ändrat inställningarna."

#: qookieqloud.php inc/adminbar-eyes.php
msgid "Connect"
msgstr "Anslut"

#: inc/v2.php
msgid "Connect to QookieQloud"
msgstr "Anslut till QookieQloud"

#: inc/connection-view.php
msgid "Connect your website to start using QookieQloud."
msgstr "Anslut din webbplats för att börja använda QookieQloud."

#: qookieqloud.php inc/adminbar-eyes.php
msgid "Connected"
msgstr "Ansluten"

#: inc/connection-view.php
#, php-format
msgid "Connected to %s"
msgstr "Ansluten till %s"

#: inc/connection-view.php
msgid "Connected to QookieQloud. Clear your site cache."
msgstr "Ansluten till QookieQloud. Töm webbplatsens cache."

#: inc/v2.php
msgid "Connected. You can return to WordPress."
msgstr "Ansluten. Du kan återvända till WordPress."

#: inc/connection-view.php
msgid "Connection"
msgstr "Anslutning"

#: inc/connection-view.php
msgid "Consent overview"
msgstr "Samtyckesöversikt"

#: inc/connection-view.php
msgid "Consents today"
msgstr "Samtycken idag"

#: inc/connection-view.php
msgid "Cookies found"
msgstr "Hittade cookies"

#: inc/connection-view.php
msgid "Custom choices today"
msgstr "Anpassade val idag"

#: inc/connection-view.php
msgid "Disconnect"
msgstr "Koppla från"

#: inc/connection-view.php
msgid "Disconnect this installation? Its private API access will be revoked and the plugin will stop loading the banner. Your domain remains in QookieQloud. Clear the site cache afterwards."
msgstr "Koppla från den här installationen? Dess privata API-åtkomst återkallas och tillägget slutar ladda bannern. Din domän finns kvar i QookieQloud. Töm webbplatsens cache efteråt."

#: inc/connection-view.php
msgid "Disconnected. Clear your site cache to remove the banner from cached pages."
msgstr "Frånkopplad. Töm webbplatsens cache för att ta bort bannern från cachade sidor."

#: inc/connection-view.php
msgid "Enable the banner"
msgstr "Aktivera bannern"

#: inc/connection-view.php
msgid "Last 30 days"
msgstr "Senaste 30 dagarna"

#: inc/connection-view.php
msgid "Last 7 days"
msgstr "Senaste 7 dagarna"

#: qookieqloud.php inc/adminbar-eyes.php
msgid "Not connected"
msgstr "Inte ansluten"

#: inc/connection-view.php
msgid "Only API access is granted. The plugin cannot sign in to your QookieQloud account. Banner design and consent settings are managed in QookieQloud."
msgstr "Endast API-åtkomst beviljas. Tillägget kan inte logga in på ditt QookieQloud-konto. Bannerns utseende och samtyckesinställningar hanteras i QookieQloud."

#: inc/connection-view.php
msgid "Open QookieQloud"
msgstr "Öppna QookieQloud"

#: inc/connection-view.php
msgid "PHP OpenSSL is required to store the connection securely."
msgstr "PHP OpenSSL krävs för att lagra anslutningen säkert."

#: inc/connection-view.php
msgid "Pages scanned"
msgstr "Skannade sidor"

#: inc/connection-view.php
msgid "Privacy audit"
msgstr "Integritetsgranskning"

#: inc/connection-view.php
msgid "Rejected today"
msgstr "Avvisat idag"

#: inc/v2.php
msgid "Return to QookieQloud"
msgstr "Tillbaka till QookieQloud"

#: inc/connection-view.php
msgid "Save settings"
msgstr "Spara inställningar"

#: inc/connection-view.php
msgid "Settings saved. Clear your site cache."
msgstr "Inställningarna har sparats. Töm webbplatsens cache."

#: inc/connection-view.php
msgid "Show the banner for logged-in users"
msgstr "Visa bannern för inloggade användare"

#: inc/connection-view.php
msgid "Sign in to QookieQloud in the window that opens."
msgstr "Logga in i QookieQloud i fönstret som öppnas."

#: inc/v2.php
msgid "Sign in to WordPress and start a new connection from QookieQloud."
msgstr "Logga in i WordPress och starta en ny anslutning från QookieQloud."

#: inc/connection-view.php
msgid "Sign in, choose your domain and approve the connection. No API keys to copy or scripts to paste."
msgstr "Logga in, välj din domän och godkänn anslutningen. Inga API-nycklar att kopiera eller skript att klistra in."

#: inc/connection-view.php
msgid "Statistics are currently unavailable. You can still manage the banner and connection below."
msgstr "Statistik är inte tillgänglig just nu. Du kan fortfarande hantera bannern och anslutningen nedan."

#: inc/connection-view.php
msgid "The action could not be completed. Your existing connection has been kept. Please try again."
msgstr "Åtgärden kunde inte slutföras. Din befintliga anslutning har behållits. Försök igen."

#: inc/v2.php
msgid "The connection could not be completed. Start again from WordPress."
msgstr "Anslutningen kunde inte slutföras. Börja om från WordPress."

#: inc/connection-view.php
msgid "This installation"
msgstr "Den här installationen"

#: inc/connection-view.php
msgid "Three steps. One connection."
msgstr "Tre steg. En anslutning."

#: inc/connection-view.php
msgid "Total consents"
msgstr "Samtycken totalt"

#: inc/v2.php
msgid "You cannot manage this connection."
msgstr "Du saknar behörighet att hantera anslutningen."

#: inc/connection-view.php
msgid "Your consent overview, banner settings and connection in one place."
msgstr "Samtycken, bannerinställningar och anslutning på ett ställe."

#: inc/connection-view.php
msgid "Your cookie banner starts here"
msgstr "Din cookiebanner börjar här"

#: inc/connection-view.php
msgid "Your existing banner keeps using v1. Connect when you are ready to switch this installation to v2."
msgstr "Din befintliga banner fortsätter använda v1. Anslut när du är redo att byta den här installationen till v2."
